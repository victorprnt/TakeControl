# Local persistence. Leave the Redis variables unset on this machine.
DATA_PROVIDER=json-server
JSON_SERVER_URL=http://127.0.0.1:3001

# Vercel. Connect Upstash Redis in the project settings.
# The integration provides UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
# (or the older KV_REST_API_URL and KV_REST_API_TOKEN).
# The first request copies db.json into the key take-control:state.
